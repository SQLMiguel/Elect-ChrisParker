# Copy this file to .env and fill in real values.
# Do NOT commit your real .env file (it is gitignored).

# ---- Email notifications (GoDaddy SMTP) ----
# Recipient that receives form submissions
NOTIFICATION_EMAIL=info@electchrisparker.org

# GoDaddy SMTP host (same for SSL and TLS)
SMTP_HOST=smtpout.secureserver.net

# Port: 587 for TLS, 465 for SSL
SMTP_PORT=587

# Set to "true" if SMTP_PORT=465 (SSL); "false" if 587 (TLS)
SMTP_SECURE=false

# Full email address used to log in to the GoDaddy mailbox
SMTP_USER=info@electchrisparker.org

# Mailbox password
SMTP_PASS=replace-with-your-mailbox-password

# Display name and address shown as the sender
SMTP_FROM=Campaign Website <info@electchrisparker.org>

# ---- Constant Contact (optional) ----
CONSTANT_CONTACT_API_KEY=
CONSTANT_CONTACT_ACCESS_TOKEN=
CONSTANT_CONTACT_LIST_ID=
